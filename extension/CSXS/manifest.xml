<?xml version="1.0" encoding="UTF-8"?>
<!-- Adobe CLI: answers the `adobe` command on 127.0.0.1 (Premiere 47651, After Effects 47652, Audition 47653).
     File access: plug-ins load their own scripts and model files from disk (GRAE Editing's face model).
     Two ways in: an invisible copy that starts with the app where the app allows it, and the
     Window > Extensions > Adobe CLI panel (Premiere 2026 only loads extensions once a project is open,
     and didn't start the invisible copy in testing, so open the panel once; it stays in the workspace). -->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  Version="9.0"
  ExtensionBundleId="com.adobecli.bridge"
  ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="Adobe CLI">
  <ExtensionList>
    <Extension Id="com.adobecli.bridge" Version="0.1.0" />
    <Extension Id="com.adobecli.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[15.0,99.9]" />
      <Host Name="AEFT" Version="[18.0,99.9]" />
      <Host Name="AUDT" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.adobecli.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.DocumentAfterActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI><Type>Custom</Type></UI>
      </DispatchInfo>
    </Extension>
    <!-- The same thing as a panel (Window > Extensions > Adobe CLI), for when the app didn't start it. -->
    <Extension Id="com.adobecli.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Adobe CLI</Menu>
          <Geometry><Size><Height>120</Height><Width>300</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
